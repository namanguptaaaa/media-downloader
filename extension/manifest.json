{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "Private Media Downloader Connection",
  "version": "1.1.0",
  "description": "Connects your Media Downloader page to your local companion. No persistent tabs, tracking, or stored credentials.",
  "key": "",
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://namanguptaaaa.github.io/media-downloader/*"],
    "js": ["validation.js", "content.js"],
    "run_at": "document_start",
    "all_frames": false
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
